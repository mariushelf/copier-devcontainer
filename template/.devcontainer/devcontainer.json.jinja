{
  "name": {{ project_name | tojson }},
  "dockerComposeFile": "docker-compose.yml",
  "service": "dev",
  "remoteUser": "dev",
  "workspaceFolder": "/workspace",

  "mounts": [
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/dev/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-shell-history,target=/commandhistory,type=volume"
  ],

  "containerEnv": {
    // Agent teams is an experimental Claude Code feature; on by default here
    // so every generated devcontainer gets it without a manual .env step
    // (unlike GH_TOKEN/CONTEXT7_API_KEY, this isn't a secret, so it doesn't
    // need to go through the gitignored .env mechanism).
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "COLORTERM": "truecolor",
    "DEVCONTAINER": "true",
    // hf_xet's parallel chunked download wedges behind the firewall proxy;
    // force classic single-stream LFS so plugin ONNX model downloads reliably.
    "HF_HUB_DISABLE_XET": "1",
    "HISTFILE": "/commandhistory/.zsh_history",
    "SHELL": "/bin/zsh",
    "TERM": "xterm-256color",
    "TZ": "Europe/Amsterdam"
  },

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  },

  // No-op ("true") when enable_firewall is false — the firewall binary and its
  // sudoers grant are still baked into the image either way (see HOWTOS.md),
  // so re-enabling later is just flipping this answer and a copier update.
  "postStartCommand": {{ ("sudo /usr/local/bin/init-firewall.sh" if enable_firewall else "true") | tojson }},
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "waitFor": "postStartCommand"
}
